{
  "name": "sponsoredtokens",
  "version": "0.3.1",
  "description": "Run your coding agent on sponsoredtokens.com — a public pool of AI tokens paid for by sponsors.",
  "type": "module",
  "bin": {
    "sponsoredtokens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/release.sh",
    "publish:npm": "npm publish --access public"
  },
  "keywords": [
    "ai",
    "cli",
    "claude-code",
    "codex",
    "openrouter",
    "sponsoredtokens"
  ],
  "homepage": "https://sponsoredtokens.com",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.9.0"
}
